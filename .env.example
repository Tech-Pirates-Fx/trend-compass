# ==============================================================================
# Trend Compass - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' if you wish to override any default settings.
# None of these variables are required for local development; all have defaults.

# --- Backend API (FastAPI) Configuration ---
PORT=8000
HOST=0.0.0.0

# Data adapter to use: 'gistemp' (default, processed NASA dataset) or 'mock' (synthetic test data)
DATA_ADAPTER=gistemp

# Path to the processed GISTEMP data directory (defaults to data-pipeline/processed/gistemp)
# GISTEMP_STORE=data-pipeline/processed/gistemp

# --- Frontend (Next.js) Configuration ---
# Target URL for backend API calls during Server-Side Rendering (SSR) or build time
PY_API_URL=http://127.0.0.1:8000
